<div class="cover-show">
  <div class="container">
    <div class="row">
      <h1 class="font-weight-normal mt-5 mb-5">旅行投稿詳細</h1>
    </div>
    <div class="d-block">
      <p class="caption">ユーザ名</p>
      <% if @post.image.attached? %>
        <%= image_tag @post.image.varient(resize_to_limit: [450, 350]) %><br>
      <% end %>
      <p class="caption"><%= @post.location %></p>
      <h2>感想</h2>
      <p id="text"><%= @post.text %></p>
      <%= link_to '変種する', edit_post_path(@post.id), class: "btn btn-into mr-3" %>
      